{
  "name": "wawatch",
  "version": "0.1.0",
  "description": "Let Claude or any AI agent watch and answer your WhatsApp chats, through MCP or webhooks, with a web UI that shows what the agent can see and send.",
  "scripts": {
    "build": "tsc -p . && vite build",
    "dev": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts --demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web"
  },
  "keywords": [
    "whatsapp",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-agent",
    "baileys"
  ],
  "author": "Ofek Gabay",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "baileys": "^7.0.0-rc14",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "bin": {
    "wawatch": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupe12334/wawatch.git"
  },
  "engines": {
    "node": ">=20.19"
  }
}
